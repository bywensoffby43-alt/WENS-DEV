<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - WensCloud</title>

    <link rel="stylesheet" href="./css/style.css">
</head>

<body>

    <nav class="navbar">

        <div class="logo">
            ☁️ WensCloud
        </div>

        <div class="nav-links">
            <a href="dashboard.html">Dashboard</a>
            <a href="bots.html">Bots</a>
            <a href="deploy.html">Deploy</a>
            <a href="settings.html">Settings</a>

            <button
                class="btn"
                onclick="logout()"
            >
                Logout
            </button>
        </div>

    </nav>

    <div class="container">

        <div class="card">

            <h2>Account Settings</h2>

            <br>

            <div class="input-group">
                <label>Username</label>
                <input
                    type="text"
                    id="username"
                >
            </div>

            <div class="input-group">
                <label>Email</label>
                <input
                    type="email"
                    id="email"
                >
            </div>

            <button
                class="btn"
                onclick="saveSettings()"
            >
                Save Changes
            </button>

        </div>

        <div class="card">

            <h2>Change Password</h2>

            <br>

            <div class="input-group">
                <input
                    type="password"
                    id="newPassword"
                    placeholder="New Password"
                >
            </div>

            <button
                class="btn"
                onclick="changePassword()"
            >
                Update Password
            </button>

        </div>

        <div class="card">

            <h2>Account Status</h2>

            <p id="statusMessage">
                Ready
            </p>

        </div>

    </div>

    <script src="./js/auth.js"></script>
    <script src="./js/settings.js"></script>

</body>

</html>